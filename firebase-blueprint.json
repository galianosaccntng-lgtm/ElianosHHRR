{
  "entities": {
    "interviews": {
      "title": "Interview Session",
      "description": "Candidate application, conversation transcript, evaluation and metadata",
      "properties": {
        "id": { "type": "string", "description": "Unique session ID" },
        "candidateName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "date": { "type": "string" },
        "completed": { "type": "boolean" },
        "status": { "type": "string" },
        "evaluation": { "type": "string" },
        "emailSent": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "lastUpdated": { "type": "string" },
        "reminderSentAt": { "type": "string" }
      },
      "required": ["id", "candidateName", "role"]
    },
    "interviewAppointments": {
      "title": "Interview Appointment",
      "description": "Scheduled 2nd in-person interview appointment with token and RingCentral SMS status",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "candidateName": { "type": "string" },
        "candidatePhone": { "type": "string" },
        "candidateEmail": { "type": "string" },
        "startUtc": { "type": "string" },
        "endUtc": { "type": "string" },
        "status": { "type": "string" },
        "token": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdByLang": { "type": "string" }
      },
      "required": ["id", "sessionId", "startUtc", "status", "token"]
    }
  },
  "firestore": {
    "collections": {
      "interviews": {
        "path": "/interviews/{interviewId}",
        "schema": {
          "$ref": "#/entities/interviews"
        },
        "indexes": [
          {
            "fields": [
              { "fieldPath": "completed", "order": "ASCENDING" },
              { "fieldPath": "date", "order": "DESCENDING" }
            ]
          }
        ]
      },
      "interviewAppointments": {
        "path": "/interviewAppointments/{appointmentId}",
        "schema": {
          "$ref": "#/entities/interviewAppointments"
        }
      }
    }
  }
}

