# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_PASSCODE: Secret passcode for HR/Staff Candidate Dashboard access.
# Defaults to "ellianos2024" if not specified. Configure your custom secret if desired.
ADMIN_PASSCODE="ellianos2024"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional SMTP configuration for automated email submission of evaluations
EMAIL_USER=""
EMAIL_PASS=""

# Optional explicit Firestore persistence flag (automatically detected if running on Cloud Run)
FIRESTORE_ENABLED="false"


